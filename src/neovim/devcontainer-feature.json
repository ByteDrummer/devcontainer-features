{
    "name": "Neovim (from prebuilt binary)",
    "id": "neovim",
    "version": "1.0.0",
    "dependsOn": {
      "ghcr.io/devcontainers/features/common-utils": {},
      "ghcr.io/devcontainers/features/git": {}
    },
    "description": "A feature to install Neovim from prebuilt binary and common plugin dependencies.",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "stable",
                "nightly",
                "0.10.4",
                "0.10.3",
                "0.10.2",
                "0.10.1",
                "0.10.0",
                "0.9.5",
                "0.9.4",
                "0.9.3",
                "0.9.2",
                "0.9.1",
                "0.9.0"
            ],
            "default": "stable",
            "description": "The version of Neovim to be installed (stable, nightly or a specific version in the format 'MAJOR.MINOR.PATCH' e.g. '0.9.5)"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/devcontainers/features/git"
    ],
    "mounts": [
        {
          "source": "${localEnv:HOME}/.config/nvim",
          "target": "/root/.config/nvim",
          "type": "bind"
        },
        {
          "source": "nvim-share",
          "target": "/root/.local/share/nvim",
          "type": "volume"
        },
        {
          "source": "nvim-state",
          "target": "/root/.local/state/nvim",
          "type": "volume"
        },
        {
          "source": "nvim-cache",
          "target": "/root/.cache/nvim",
          "type": "volume"
        }
    ]
}
